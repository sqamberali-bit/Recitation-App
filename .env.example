# ---------------------------------------------------------------------------
# Recitation App — environment variables (all OPTIONAL)
#
# The app works fully offline with NO backend. These variables only enable
# the optional cloud sync / AI-correction integrations. Copy this file to
# `.env` and fill in values if you want those features at build time. You can
# also configure them at runtime from Settings without rebuilding.
# ---------------------------------------------------------------------------

# Optional: default endpoint for a self-hosted sync server (see docs/SYNC.md).
# Leave blank to keep the app 100% local.
VITE_SYNC_ENDPOINT=

# Optional: default endpoint for an AI OCR-correction proxy that forwards to
# the Claude API (see docs/AI.md). NEVER put a raw API key here for a client
# build — always proxy through a server you control.
VITE_AI_CORRECTION_ENDPOINT=

# Optional: Azure AD application (client) ID for OneNote import.
# Register a free SPA app at portal.azure.com → App registrations → New.
# Set the redirect URI to your app's origin (e.g. http://localhost:5173).
# No client secret is needed — the app uses browser-based PKCE auth.
VITE_ONENOTE_CLIENT_ID=
