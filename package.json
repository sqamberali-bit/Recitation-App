{
  "name": "recitation-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first PWA for storing, organising, and reciting Urdu & English poems and nohas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit",
    "gen:icons": "node scripts/gen-icons.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "test:e2e": "node tests/e2e.mjs && node tests/malformed-import.mjs && node tests/editor-safety.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "^0.8.2",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright": "^1.62.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
